# Copy to .env.local and fill in from Supabase: Project Settings > API.
# Only the anon (public) key goes here. Never put the service-role key in
# any VITE_ variable: everything prefixed VITE_ is shipped to the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. The base URL put in approval links. Defaults to the address the
# app is opened on, which is right for Netlify. Set it if you test from a
# local network address but want links to point at the deployed site.
# VITE_PUBLIC_URL=https://jobthread.netlify.app

# Optional. Where "Send feedback" emails go. Defaults to hello@jobthread.ca.
# VITE_FEEDBACK_EMAIL=you@example.com
